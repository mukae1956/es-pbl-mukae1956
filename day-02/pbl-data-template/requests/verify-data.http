# contents를 자신의 index 이름으로 이미 반영했습니다. Kibana Dev Tools에서 실행합니다.
GET /contents/_count

GET /contents/_search
{
  "size": 0,
  "aggs": {
    "genre_count": { "terms": { "field": "genre", "size": 20 } },
    "available_count": { "terms": { "field": "available", "size": 2 } },
    "running_time_stats": { "stats": { "field": "running_time" } },
    "rating_stats": { "stats": { "field": "rating" } }
  }
}
