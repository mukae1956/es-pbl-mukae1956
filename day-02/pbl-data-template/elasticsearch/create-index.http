# S33에서 이미 만든 index에는 이 PUT을 다시 실행하지 않는다. 없을 때만 생성한다.
# index 이름과 properties가 my-data-settings.ps1의 field 이름·Kind와 맞는지 먼저 확인합니다.
PUT /contents
{
  "settings": { "number_of_shards": 1, "number_of_replicas": 1 },
  "mappings": {
    "properties": {
      "content_id": { "type": "keyword" },
      "title": { "type": "text" },
      "available": { "type": "boolean" },
      "genre": { "type": "keyword" },
      "running_time": { "type": "integer" },
      "rating": { "type": "float" },
      "cast": { "type": "text" },
      "director": { "type": "text" }
    }
  }
}

GET /contents/_mapping
